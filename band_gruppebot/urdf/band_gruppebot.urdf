  <!-- ===================== Feste til verden ===================== -->
  <!-- Uten dette er fotplata (6 kg) løs, og armen på 1,8 m velter i Gazebo. -->
  <link name="world"/>
  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- ===================== DH-basis {0} ===================== -->
  <!-- Robotens basisramme, den samme som DH-tabellen og MATLAB-koden bruker (d1 = 0,35).
       Den ligger oppå fotplata, som er 0,02 m tykk: p(world) = p({0}) + [0 0 0.02].
       Sjekk mot fkine i MATLAB: ros2 run tf2_ros tf2_echo dh_base tcp_link -->
  <link name="dh_base"/>
  <joint name="base_to_dh_base" type="fixed">
    <parent link="base_link"/>
    <child link="dh_base"/>
    <origin rpy="0 0 0" xyz="0 0 0.02"/>
  </joint>
  <!-- ===================== Verktøypunkt (TCP) ===================== -->
  <!-- Samme punkt som robot.tool = transl(0.17, 0, 0.03) i MATLAB.
       z er 0,035 her fordi gripper-ramma ligger 5 mm inne i link3 (leddet er 0,155 i
       Fusion, d5 = 0,16 i DH). 0,155 + 0,035 = 0,16 + 0,03 = 0,19 m under håndleddet,
       som også er undersiden av sugekoppene i 3D-modellen. -->
  <link name="tcp_link"/>
  <joint name="gripper_to_tcp" type="fixed">
    <parent link="gripper"/>
    <child link="tcp_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.17 0.0 0.035"/>
  </joint>
  <!-- ===================== Kamera (RealSense D455, forenklet) ===================== -->
  <!-- Henger fast i (1.0, -1.0, 1.5) i robotens basisramme {0} og ser rett ned på båndet,
       1 m oppstrøms for roboten.
       kamera_link:   x peker ut av linsa (ned). Dette er ramma Gazebo-kameraet bruker.
       kamera_optisk: samme ramme som T_C = transl(1, -1, 1.5) * trotx(pi) i MATLAB
                      (x som {0}, y motsatt, z ned). Målingene publiseres i denne.
       Sjekk: ros2 run tf2_ros tf2_echo dh_base kamera_optisk -->
  <link name="kamera_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="5e-4" ixy="0" ixz="0" iyy="5e-4" iyz="0" izz="5e-4"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="-0.013 0 0"/>
      <geometry>
        <box size="0.026 0.124 0.029"/>
      </geometry>
      <material name="Kamera"/>
    </visual>
  </link>
  <joint name="base_to_kamera" type="fixed">
    <parent link="dh_base"/>
    <child link="kamera_link"/>
    <origin rpy="0 1.5707963267948966 0" xyz="1.0 -1.0 1.5"/>
  </joint>
  <link name="kamera_optisk"/>
  <joint name="kamera_to_optisk" type="fixed">
    <parent link="kamera_link"/>
    <child link="kamera_optisk"/>
    <!-- gir dh_base -> kamera_optisk = Rx(pi) -->
    <origin rpy="3.141592653589793 -1.5707963267948966 0" xyz="0 0 0"/>
  </joint>
  <ros2_control name="band_gruppebot_system" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
    <joint name="Revolute_1">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="Revolute_2">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">1.6371</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="Revolute_3">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">-2.1101</param>
      </state_interface>
      <state_interface name="velocity"/>
