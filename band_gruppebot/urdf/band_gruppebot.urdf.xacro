<?xml version="1.0"?>
<!--
  band_gruppebot - komplett robotsystem (krav 5.i)

  Denne fila setter sammen:
    1. robotarmen fra Fusion (urdf/assemblies/band_gruppebot.urdf.xacro)
    2. feste til verden (world), slik at roboten ikke velter i Gazebo
    3. dh_base: basisrammen som DH-tabellen i MATLAB bruker (oppå fotplata)
    4. tcp_link: verktøypunktet (sugekoppene)
    5. kameraet over båndet
    6. ros2_control + Gazebo-plugin (bare når sim_gazebo:=true)

  Argumenter:
    prefix:=...           prefiks på ledd/lenker (som før)
    sim_gazebo:=true      bruk Gazebo som "hardware" (ellers mock_components)
    kamera_sensor:=true   la Gazebo rendre kamerabilde (krever GPU/OpenGL)
    antall_esker:=6       antall esker (eske1, eske2, ...) som vakuumet kan holde
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="band_gruppebot">

  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="sim_gazebo" default="false"/>
  <xacro:arg name="kamera_sensor" default="false"/>
  <xacro:arg name="antall_esker" default="6"/>
  <xacro:property name="prefix" value="$(arg prefix)"/>

  <!-- Materials (shared across all assemblies) -->
  <material name="Steel">
    <color rgba="0.627 0.627 0.627 1.0"/>
  </material>
  <material name="Aluminum">
    <color rgba="0.961 0.961 0.965 1.0"/>
  </material>
  <material name="Kamera">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <!-- Assembly includes -->
  <xacro:include filename="$(find band_gruppebot)/urdf/assemblies/band_gruppebot.urdf.xacro"/>
  <xacro:include filename="$(find band_gruppebot)/urdf/band_gruppebot.ros2_control.xacro"/>

  <!-- Instantiate assemblies -->
  <xacro:band_gruppebot prefix="${prefix}"/>

  <!-- ===================== Feste til verden ===================== -->
  <!-- Uten dette er fotplata (6 kg) løs, og armen på 1,8 m velter i Gazebo. -->
  <link name="world"/>
  <joint name="${prefix}world_fixed" type="fixed">
    <parent link="world"/>
    <child link="${prefix}base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===================== DH-basis {0} ===================== -->
  <!-- Robotens basisramme, den samme som DH-tabellen og MATLAB-koden bruker (d1 = 0,35).
       Den ligger oppå fotplata, som er 0,02 m tykk: p(world) = p({0}) + [0 0 0.02]. -->
  <link name="${prefix}dh_base"/>
  <joint name="${prefix}base_to_dh_base" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}dh_base"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Verktøypunkt (TCP) ===================== -->
  <!-- Samme punkt som robot.tool = transl(0.17, 0, 0.03) i MATLAB.
       z er 0,035 her fordi gripper-ramma ligger 5 mm inne i link3 (leddet er 0,155 i
       Fusion, d5 = 0,16 i DH). 0,155 + 0,035 = 0,16 + 0,03 = 0,19 m under håndleddet,
       som også er undersiden av sugekoppene i 3D-modellen. -->
  <link name="${prefix}tcp_link"/>
  <joint name="${prefix}gripper_to_tcp" type="fixed">
    <parent link="${prefix}gripper"/>
    <child link="${prefix}tcp_link"/>
    <origin xyz="0.17 0.0 0.035" rpy="0.0 0.0 0.0"/>
  </joint>

  <!-- ===================== Kamera (RealSense D455, forenklet) ===================== -->
  <!-- Henger fast i (1.0, -1.0, 1.5) i robotens basisramme {0} og ser rett ned på båndet,
       1 m oppstrøms for roboten. -->
  <link name="kamera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="5e-4" ixy="0" ixz="0" iyy="5e-4" iyz="0" izz="5e-4"/>
    </inertial>
    <visual>
      <origin xyz="-0.013 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.026 0.124 0.029"/>
      </geometry>
      <material name="Kamera"/>
    </visual>
  </link>
  <joint name="base_to_kamera" type="fixed">
    <parent link="${prefix}dh_base"/>
    <child link="kamera_link"/>
    <origin xyz="1.0 -1.0 1.5" rpy="0 ${pi/2} 0"/>
  </joint>

  <link name="kamera_optisk"/>
  <joint name="kamera_to_optisk" type="fixed">
    <parent link="kamera_link"/>
    <child link="kamera_optisk"/>
    <!-- gir dh_base -> kamera_optisk = Rx(pi) -->
    <origin xyz="0 0 0" rpy="${pi} ${-pi/2} 0"/>
  </joint>

  <!-- ===================== ros2_control ===================== -->
  <!-- Startstilling: griperen peker ned i (0.75, 0, 0.75) i {0} -->
  <xacro:band_gruppebot_ros2_control prefix="${prefix}" sim_gazebo="$(arg sim_gazebo)"
      q1="0.0000" q2="1.6371" q3="-2.1101" q4="0.4730" q5="0.0000"/>

  <!-- ===================== Gazebo ===================== -->
  <xacro:if value="$(arg sim_gazebo)">
    <gazebo>
      <!-- Kobler leddene i Gazebo til ros2_control (controller_manager kjører inne i Gazebo) -->
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find band_gruppebot)/config/ros2_controllers.yaml</parameters>
      </plugin>
    </gazebo>

    <!-- Vakuum: Gazebo lager et fast ledd mellom griperen og en eske når scripts/celle.py
         ber om det, og fjerner det igjen ved slipp. Ett plugin per eske (eske1, eske2, ...). -->
    <xacro:macro name="vakuum" params="n">
      <xacro:if value="${n > 0}">
        <gazebo>
          <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
            <parent_link>${prefix}gripper</parent_link>
            <child_model>eske${n}</child_model>
            <child_link>eske${n}_lenke</child_link>
            <attach_topic>/model/eske${n}/detachable_joint/attach</attach_topic>
            <detach_topic>/model/eske${n}/detachable_joint/detach</detach_topic>
            <output_topic>/model/eske${n}/detachable_joint/state</output_topic>
            <suppress_child_warning>true</suppress_child_warning>
          </plugin>
        </gazebo>
        <xacro:vakuum n="${n - 1}"/>
      </xacro:if>
    </xacro:macro>
    <xacro:vakuum n="$(arg antall_esker)"/>

    <gazebo reference="kamera_link">
      <visual>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </gazebo>

    <xacro:if value="$(arg kamera_sensor)">
      <gazebo reference="kamera_link">
        <sensor name="kamera" type="camera">
          <always_on>1</always_on>
          <update_rate>15</update_rate>
          <visualize>true</visualize>
          <topic>kamera/image</topic>
          <gz_frame_id>kamera_link</gz_frame_id>
          <camera>
            <horizontal_fov>1.518</horizontal_fov> <!-- 87 grader, som D455 -->
            <image>
              <width>848</width>
              <height>480</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>10</far>
            </clip>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:if>

</robot>
