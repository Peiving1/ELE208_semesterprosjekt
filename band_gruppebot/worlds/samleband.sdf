<?xml version="1.0" ?>
<!--
  Arbeidscellen til band_gruppebot (krav 5.ii). Alt er laget av enkle grunnformer.

  Høydene er valgt slik at de blir runde tall i robotens basisramme {0} (oppå fotplata,
  0,02 m over gulvet), den samme ramma som MATLAB-koden regner i. Gazebo (world) regner
  fra gulvet, så z(world) = z({0}) + 0,02.

    - Samlebånd:  langs y ved x = 1.0, fra y = -4.0 til y = 1.0. Toppen er på z = 0.30 i {0}.
                  Båndet går i +y med 0.3 m/s (startes av scripts/celle.py).
    - Esker:      0.30 x 0.20 x 0.10 m, 5 kg. Toppen er på z = 0.40 i {0} når de ligger på
                  båndet. Eskene settes inn av launch-fila (models/eske.sdf.xacro), ikke her.
    - Kamera:     (1.0, -1.0, 1.5) i {0}, ligger i URDF-en. Stativet står her.
    - Bord:       avlevering, midt i (0, 1.17), toppen på z = 0.40 i {0}.
    - Lager:      pall ved (2.0, -3.0) der eskene venter før de mates inn på båndet.
-->
<sdf version="1.9">
  <world name="samleband">
    <!-- 2 ms steg (500 Hz): halvparten så tungt å regne som 1 ms, og nøyaktig nok her -->
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.80 0.85 1</background>
    </scene>

    <gui fullscreen="0">
        <!-- 3D scene -->
        <plugin filename="MinimalScene" name="3D View">
          <gz-gui>
            <title>3D View</title>
            <property type="bool" key="showTitleBar">false</property>
            <property type="string" key="state">docked</property>
          </gz-gui>

          <engine>ogre2</engine>
          <scene>scene</scene>
          <ambient_light>0.4 0.4 0.4</ambient_light>
          <background_color>0.8 0.8 0.8</background_color>
          <!-- Ser på cellen skrått forfra -->
          <camera_pose>4.0 -1.5 2.6 0 0.52 2.74</camera_pose>
        </plugin>

        <!-- Plugins that add functionality to the scene -->
        <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
          <gz-gui>
            <property key="state" type="string">floating</property>
            <property key="width" type="double">5</property>
            <property key="height" type="double">5</property>
            <property key="showTitleBar" type="bool">false</property>
          </gz-gui>
        </plugin>
        <plugin filename="GzSceneManager" name="Scene Manager">
          <gz-gui>
            <property key="resizable" type="bool">false</property>
            <property key="width" type="double">5</property>
            <property key="height" type="double">5</property>
            <property key="state" type="string">floating</property>
            <property key="showTitleBar" type="bool">false</property>
          </gz-gui>
        </plugin>
        <plugin filename="InteractiveViewControl" name="Interactive view control">
          <gz-gui>
            <property key="resizable" type="bool">false</property>
            <property key="width" type="double">5</property>
            <property key="height" type="double">5</property>
            <property key="state" type="string">floating</property>
            <property key="showTitleBar" type="bool">false</property>
          </gz-gui>
        </plugin>
        <plugin filename="CameraTracking" name="Camera Tracking">
          <gz-gui>
            <property key="resizable" type="bool">false</property>
            <property key="width" type="double">5</property>
            <property key="height" type="double">5</property>
            <property key="state" type="string">floating</property>
            <property key="showTitleBar" type="bool">false</property>
          </gz-gui>
        </plugin>

        <plugin name='World control' filename='WorldControl'>
            <gz-gui>
                <title>World control</title>
                <property type='bool' key='showTitleBar'>0</property>
                <property type='bool' key='resizable'>0</property>
                <property type='double' key='height'>72</property>
                <property type='double' key='width'>150</property>
                <property type='double' key='z'>1</property>
                <property type='string' key='state'>floating</property>
                <anchors target='3D View'>
                    <line own='left' target='left'/>
                    <line own='bottom' target='bottom'/>
                </anchors>
            </gz-gui>
            <play_pause>1</play_pause>
            <step>1</step>
            <start_paused>0</start_paused>
        </plugin>

        <!-- World statistics -->
        <plugin filename="WorldStats" name="World stats">
            <gz-gui>
                <title>World stats</title>
                <property type="bool" key="showTitleBar">false</property>
                <property type="bool" key="resizable">false</property>
                <property type="double" key="height">110</property>
                <property type="double" key="width">290</property>
                <property type="double" key="z">1</property>

                <property type="string" key="state">floating</property>
                <anchors target="3D View">
                    <line own="right" target="right"/>
                    <line own="bottom" target="bottom"/>
                </anchors>
            </gz-gui>

            <sim_time>true</sim_time>
            <real_time>true</real_time>
            <real_time_factor>true</real_time_factor>
            <iterations>true</iterations>
        </plugin>

        <!-- Translate / rotate -->
        <plugin filename="TransformControl" name="Transform control">
            <gz-gui>
                <title>Transform control</title>
                <anchors target="3D View">
                    <line own="left" target="left"/>
                    <line own="top" target="top"/>
                </anchors>
                <property key="resizable" type="bool">false</property>
                <property key="width" type="double">230</property>
                <property key="height" type="double">50</property>
                <property key="state" type="string">floating</property>
                <property key="showTitleBar" type="bool">false</property>
                <property key="cardBackground" type="string">#666666</property>
            </gz-gui>
        </plugin>

        <!-- Insert simple shapes -->
        <plugin filename="Shapes" name="Shapes">
            <gz-gui>
                <anchors target="Transform control">
                    <line own="left" target="right"/>
                    <line own="top" target="top"/>
                </anchors>
                <property key="resizable" type="bool">false</property>
                <property key="width" type="double">200</property>
                <property key="height" type="double">50</property>
                <property key="state" type="string">floating</property>
                <property key="showTitleBar" type="bool">false</property>
                <property key="cardBackground" type="string">#666666</property>
            </gz-gui>
        </plugin>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== Samlebånd ===================== -->
    <!-- Modellen er rotert 90 grader, så båndets +x (fartsretningen) er +y i verden.
         TrackController gir kontaktflaten en fart, slik at alt som ligger på båndet
         blir med (samme oppsett som conveyor.sdf i Gazebo-eksemplene).
         Fart: gz.msgs.Double på /model/samleband/link/belte/track_cmd_vel
               (fra ROS: std_msgs/Float64 på /samleband/fart). -->
    <model name="samleband">
      <static>1</static>
      <pose>1.0 -1.5 0.27 0 0 1.570796327</pose>
      <link name="belte">
        <pose relative_to="__model__">0 0 0 0 0 0</pose>
        <inertial>
          <mass>50</mass>
          <inertia>
            <ixx>1.0</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>100</iyy>
            <iyz>0</iyz>
            <izz>100</izz>
          </inertia>
        </inertial>
        <collision name="band_kollisjon">
          <geometry>
            <box>
              <size>5.0 0.5 0.1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.7</mu>
                <mu2>150</mu2>
                <fdir1>0 1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
        <collision name="rull_slutt_kollisjon">
          <pose>2.5 0 0 -1.570796327 0 0</pose>
          <geometry>
            <cylinder>
              <length>0.5</length>
              <radius>0.05</radius>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.7</mu>
                <mu2>150</mu2>
                <fdir1>0 1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
        <collision name="rull_start_kollisjon">
          <pose>-2.5 0 0 -1.570796327 0 0</pose>
          <geometry>
            <cylinder>
              <length>0.5</length>
              <radius>0.05</radius>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.7</mu>
                <mu2>150</mu2>
                <fdir1>0 1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="band">
          <geometry>
            <box>
              <size>5.0 0.5 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.10 0.12 1</ambient>
            <diffuse>0.10 0.10 0.12 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <visual name="rull_slutt">
          <pose>2.5 0 0 -1.570796327 0 0</pose>
          <geometry>
            <cylinder>
              <length>0.5</length>
              <radius>0.05</radius>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.10 0.10 0.12 1</ambient>
            <diffuse>0.10 0.10 0.12 1</diffuse>
          </material>
        </visual>
        <visual name="rull_start">
          <pose>-2.5 0 0 -1.570796327 0 0</pose>
          <geometry>
            <cylinder>
              <length>0.5</length>
              <radius>0.05</radius>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.10 0.10 0.12 1</ambient>
            <diffuse>0.10 0.10 0.12 1</diffuse>
          </material>
        </visual>
        <!-- Understell (bare til pynt, ingen kollisjon) -->
        <visual name="ramme_venstre">
          <pose>0 0.27 -0.03 0 0 0</pose>
          <geometry>
            <box>
              <size>5.1 0.04 0.12</size>
            </box>
          </geometry>
          <material>
            <ambient>0.20 0.35 0.60 1</ambient>
            <diffuse>0.20 0.35 0.60 1</diffuse>
          </material>
        </visual>
        <visual name="ramme_hoyre">
          <pose>0 -0.27 -0.03 0 0 0</pose>
          <geometry>
            <box>
              <size>5.1 0.04 0.12</size>
            </box>
          </geometry>
          <material>
            <ambient>0.20 0.35 0.60 1</ambient>
            <diffuse>0.20 0.35 0.60 1</diffuse>
          </material>
        </visual>
        <visual name="bein_1">
          <pose>-2.2 0 -0.16 0 0 0</pose>
          <geometry>
            <box>
              <size>0.06 0.5 0.22</size>
            </box>
          </geometry>
          <material>
            <ambient>0.20 0.35 0.60 1</ambient>
            <diffuse>0.20 0.35 0.60 1</diffuse>
          </material>
        </visual>
        <visual name="bein_2">
          <pose>0 0 -0.16 0 0 0</pose>
          <geometry>
            <box>
              <size>0.06 0.5 0.22</size>
            </box>
          </geometry>
          <material>
            <ambient>0.20 0.35 0.60 1</ambient>
            <diffuse>0.20 0.35 0.60 1</diffuse>
          </material>
        </visual>
        <visual name="bein_3">
          <pose>2.2 0 -0.16 0 0 0</pose>
          <geometry>
            <box>
              <size>0.06 0.5 0.22</size>
            </box>
          </geometry>
          <material>
            <ambient>0.20 0.35 0.60 1</ambient>
            <diffuse>0.20 0.35 0.60 1</diffuse>
          </material>
        </visual>
        <gravity>1</gravity>
        <kinematic>0</kinematic>
      </link>

      <plugin filename="gz-sim-track-controller-system"
              name="gz::sim::systems::TrackController">
        <link>belte</link>
        <odometry_publish_frequency>10</odometry_publish_frequency>
        <max_velocity>1.0</max_velocity>
        <min_velocity>-1.0</min_velocity>
      </plugin>
    </model>

    <!-- ===================== Avleveringsbord ===================== -->
    <!-- Eskene legges i (-0.25, 1.17), (0, 1.17) og (0.25, 1.17): opptil 1.2 m fra basen.
         Bordplata er 0.04 m tykk, toppen er 0.42 m over gulvet = 0.40 m i {0}. -->
    <model name="bord">
      <static>true</static>
      <pose>0 1.17 0 0 0 0</pose>
      <link name="link">
        <collision name="plate_kollisjon">
          <pose>0 0 0.40 0 0 0</pose>
          <geometry>
            <box>
              <size>0.9 0.5 0.04</size>
            </box>
          </geometry>
        </collision>
        <visual name="plate">
          <pose>0 0 0.40 0 0 0</pose>
          <geometry>
            <box>
              <size>0.9 0.5 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.40 0.25 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
          </material>
        </visual>
        <visual name="bein_1">
          <pose>0.40 0.20 0.19 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.38</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <visual name="bein_2">
          <pose>-0.40 0.20 0.19 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.38</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <visual name="bein_3">
          <pose>0.40 -0.20 0.19 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.38</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <visual name="bein_4">
          <pose>-0.40 -0.20 0.19 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.38</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== Kamerastativ ===================== -->
    <!-- Kameraet selv ligger i URDF-en (kamera_link i (1.0, -1.0, 1.5) i {0}). -->
    <model name="kamerastativ">
      <static>true</static>
      <pose>1.45 -1.0 0 0 0 0</pose>
      <link name="link">
        <collision name="stolpe_kollisjon">
          <pose>0 0 0.785 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 1.57</size>
            </box>
          </geometry>
        </collision>
        <visual name="stolpe">
          <pose>0 0 0.785 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 1.57</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <visual name="arm">
          <pose>-0.225 0 1.55 0 0 0</pose>
          <geometry>
            <box>
              <size>0.45 0.04 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== Lager (pall) ===================== -->
    <model name="lager">
      <static>true</static>
      <pose>2.0 -3.0 0 0 0 0</pose>
      <link name="link">
        <collision name="pall_kollisjon">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>0.5 2.4 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="pall">
          <pose>0 0 0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>0.5 2.4 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.50 0.30 1</ambient>
            <diffuse>0.65 0.50 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
